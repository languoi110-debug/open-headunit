<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/mirror_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/mirror_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC071B24"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/mirror_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mirror_waiting"
            android:textColor="#22D3A6"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mirror_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B8CCD3"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/mirror_exit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="#CC102F3B"
        android:text="@string/mirror_exit"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</FrameLayout>
